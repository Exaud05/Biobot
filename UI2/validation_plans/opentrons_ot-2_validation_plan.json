{
  "robot_platform": "Opentrons OT-2",
  "code_path": "generated_code/generated_script.py",
  "validation_tool": "opentrons_simulate",
  "environment": {
    "type": "conda",
    "name": "opentrons-sim",
    "python_version": "3.10"
  },
  "steps": [
    {
      "name": "create_env",
      "command": "conda create -y -n opentrons-sim python=3.10"
    },
    {
      "name": "install_dependencies",
      "command": "conda run -n opentrons-sim pip install opentrons"
    },
    {
      "name": "run_validation",
      "command": "conda run -n opentrons-sim opentrons_simulate generated_code/generated_script.py"
    }
  ],
  "checks_performed": [
    "syntax",
    "typing",
    "api-usage",
    "robot-constraints"
  ],
  "notes": "Uses the official Opentrons simulator to validate a Protocol API v2 script without hardware; prints timeline and raises API/labware/constraint errors."
}